{
	"name": "@codingcatdev/streamdeck",
	"version": "0.1.0",
	"private": true,
	"description": "CodingCat.dev Elgato Stream Deck plugins monorepo",
	"repository": {
		"type": "git",
		"url": "https://github.com/CodingCatDev/streamdeck.git"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"typecheck": "pnpm -r run typecheck",
		"validate": "pnpm -r run validate",
		"pack": "pnpm -r run pack",
		"lifx:watch": "pnpm --filter @codingcatdev/streamdeck-lifx run watch",
		"lifx:link": "pnpm --filter @codingcatdev/streamdeck-lifx run link",
		"lifx:pack": "pnpm --filter @codingcatdev/streamdeck-lifx run pack"
	},
	"type": "module"
}