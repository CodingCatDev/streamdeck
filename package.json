{
	"name": "@codingcatdev/streamdeck",
	"version": "0.1.0",
	"private": true,
	"description": "CodingCat.dev Elgato Stream Deck plugin",
	"repository": {
		"type": "git",
		"url": "https://github.com/CodingCatDev/streamdeck.git"
	},
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart dev.codingcat.streamdeck\"",
		"typecheck": "tsc --noEmit",
		"validate": "streamdeck validate dev.codingcat.streamdeck.sdPlugin",
		"pack": "pnpm run build && streamdeck pack dev.codingcat.streamdeck.sdPlugin --force",
		"link": "streamdeck link dev.codingcat.streamdeck.sdPlugin && streamdeck restart dev.codingcat.streamdeck"
	},
	"devDependencies": {
		"@elgato/cli": "^1.6.0",
		"@rollup/plugin-commonjs": "^28.0.0",
		"@rollup/plugin-node-resolve": "^15.2.2",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/node": "~20.15.0",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.0.0"
	}
}